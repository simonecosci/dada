APP_NAME=dada
# Production defaults (Horizon is open to everyone only in `local`).
# For development set APP_ENV=local and APP_DEBUG=true in your .env.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dada
DB_USERNAME=dada
# Required: also used as POSTGRES_PASSWORD by docker-compose.example.yml
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb credentials: generate them, e.g. `openssl rand -hex 16` (key) and
# `openssl rand -hex 32` (secret). Leave blank in the repository.
# With Docker, nginx proxies /app and /apps to Reverb, so the public port is
# the web port (8000, or 443 behind TLS) instead of 8080.
REVERB_APP_ID=dada
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Public Reverb endpoint used by the browser, read at runtime (shared with the
# page together with REVERB_APP_KEY; the secret is never sent). Leave blank to
# use the page origin, which is right for the Docker image (nginx proxies /app).
# Set them when Reverb is reachable elsewhere, e.g. behind a separate hostname.
# REVERB_CLIENT_HOST=dada.example.com
# REVERB_CLIENT_PORT=443
# REVERB_CLIENT_SCHEME=https

# Build-time fallback for local development (`npm run dev`), used only when the
# REVERB_CLIENT_* values above are blank.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- dada ---
# Container role: web | worker | scheduler | reverb | all (default all)
DADA_ROLE=all
# Run `php artisan migrate --force` at start (default: true for web/all, false otherwise)
# DADA_MIGRATE=true
# Upstream for the nginx /app and /apps websocket proxy (default 127.0.0.1:8080)
# REVERB_UPSTREAM=reverb:8080

# Minimum free disk space (MB) required on the host before a deploy
DADA_DEPLOY_MIN_FREE_MB=1024
# Pre-deploy backups kept per deployment host
DADA_DEPLOY_BACKUP_RETENTION=10
# TTL (seconds) of the active-run lock; also bounds the deploy job timeout
DADA_DEPLOY_LOCK_TTL=3600
# retry_after (seconds) of the redis-deploy queue connection (default: LOCK_TTL + 120)
# DADA_DEPLOY_RETRY_AFTER=3720
# SSH timeouts (seconds)
DADA_SSH_CONNECT_TIMEOUT=10
DADA_SSH_COMMAND_TIMEOUT=1800
